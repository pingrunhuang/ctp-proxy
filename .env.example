# CTP market-data broker, user, and front
CTP_MD_BROKER_ID=9999
CTP_MD_USER_ID=160579
CTP_MD_PASSWORD=change_me
CTP_FRONT_MD=tcp://182.254.243.31:40011

# CTP trading broker, user, authentication, and front
CTP_ENABLE_TD=true
CTP_TD_BROKER_ID=9999
CTP_TD_USER_ID=160579
CTP_TD_PASSWORD=change_me
CTP_APP_ID=simnow_client_test
CTP_AUTH_CODE=0000000000000000
CTP_FRONT_TD=tcp://182.254.243.31:40001
CTP_PRODUCTION_MODE=false
# Passed to CreateFtdcMdApi/CreateFtdcTraderApi. Set false for compatible
# non-production front environments. Legacy CTP_PRODUCTION_MODE is also accepted.

# Optional startup subscriptions
CTP_ENABLE_MD=true
CTP_SYMBOLS=ag2609,ag2608

# ZeroMQ endpoints. Defaults are deliberately different from ibkr-proxy.
ZMQ_BIND_HOST=0.0.0.0
ZMQ_PUB_PORT=5565
ZMQ_REP_PORT=5566

# CTP query serialization and snapshots
CTP_QUERY_MIN_INTERVAL_SECONDS=1.0
CTP_QUERY_TIMEOUT_SECONDS=10.0
CTP_SNAPSHOT_TTL_SECONDS=5.0

# PostgreSQL order persistence
DATABASE_URL=postgresql://ctp_proxy:ctp_proxy_change_me@127.0.0.1:5432/ctp_proxy
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Used by docker-compose.yml. Change the password before deployment.
POSTGRES_DATA_DIR=./data
POSTGRES_DB=ctp_proxy
POSTGRES_USER=ctp_proxy
POSTGRES_PASSWORD=ctp_proxy_change_me

# Runtime state
CTP_FLOW_PATH=flow

# Logging
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=30
LOG_DIR=logs
